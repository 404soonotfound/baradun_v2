  "AWS::Logs::LogGroup": [
    {
      "permissions": [
        "firehose:TagDeliveryStream",
        "logs:CreateLogDelivery",
        "s3:REST.PUT.OBJECT"
      ],
      "absentProperties": ["LogGroupClass"],
      "reason": "CloudFormation 스키마의 선택 로그 전달 의존 권한. DELIVERY 로그 그룹 클래스 미사용이며 로그 전달 리소스도 종류 가드레일로 차단. REST.PUT.OBJECT는 IAM Action이 아님"
    },
    {
      "permissions": ["logs:AssociateKmsKey", "logs:DisassociateKmsKey"],
      "absentProperties": ["KmsKeyId"],
      "reason": "로그 고객 관리 KMS 키 미사용"
