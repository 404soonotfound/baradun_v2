{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StackLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": [
        "arn:aws:logs:ap-northeast-2:717304679248:log-group:BaradunV2-*",
        "arn:aws:logs:ap-northeast-2:717304679248:log-group:BaradunV2-*:*"
      ]
    },
    {
      "Sid": "StackTables",
      "Effect": "Allow",
      "Action": [
        "dynamodb:BatchGetItem",
        "dynamodb:DeleteItem",
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:Query",
        "dynamodb:UpdateItem"
      ],
      "Resource": "arn:aws:dynamodb:ap-northeast-2:717304679248:table/BaradunV2-*"
    },
    {
      "Sid": "ApiKeys",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:ap-northeast-2:717304679248:parameter/baradun/v2/api-keys/*",
      "Condition": {
        "ArnLike": {
          "lambda:SourceFunctionArn": "arn:aws:lambda:ap-northeast-2:717304679248:function:BaradunV2-*"
        }
      }
    },
    {
      "Sid": "DecryptApiKeysViaSsm",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "arn:aws:kms:ap-northeast-2:717304679248:key/*",
      "Condition": {
        "StringEquals": { "kms:ViaService": "ssm.ap-northeast-2.amazonaws.com" }
      }
    },
    {
      "Sid": "SiteBucketObjects",
      "Effect": "Allow",
      "Action": ["s3:DeleteObject", "s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::baradunv2-*/*"
    },
    {
      "Sid": "SiteBucketList",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::baradunv2-*"
    },
    {
      "Sid": "SiteInvalidation",
      "Effect": "Allow",
      "Action": "cloudfront:CreateInvalidation",
      "Resource": "arn:aws:cloudfront::717304679248:distribution/*"
    },
    {
      "Sid": "InvokeStackFunctions",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:lambda:ap-northeast-2:717304679248:function:BaradunV2-*"
    },
    {
      "Sid": "InquiryNotifications",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:ap-northeast-2:717304679248:BaradunV2-*"
    }
  ]
}
