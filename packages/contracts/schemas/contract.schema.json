{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baradun.dev/schemas/contract-v1.json",
  "title": "Contract",
  "description": "바라던 바다 V2 공개 데이터 계약 v1 (아키텍처 6.3, 결정 기록 11장 B2). 파일마다 $defs의 *File 정의를 따름.",
  "$defs": {
    "ManifestFile": {
      "title": "ManifestFile",
      "description": "/data/manifest.json. 브라우저가 가장 먼저 받는 파일. 60초 캐시.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "snapshotVersion",
        "policyVersion",
        "generatedAt",
        "maintenance",
        "minWebBuild",
        "files"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1,
          "description": "계약 버전. 화면이 지원하지 않는 값이면 새로고침 후 판단불가(아키텍처 9.1)."
        },
        "snapshotVersion": {
          "type": "string",
          "pattern": "^[0-9]{8}T[0-9]{6}Z$",
          "description": "게시 버전. 예: 20261017T053000Z"
        },
        "policyVersion": {
          "type": "string",
          "minLength": 1,
          "description": "분류 규칙 버전(지연 기준 등)."
        },
        "generatedAt": { "$ref": "#/$defs/DateTime" },
        "maintenance": { "$ref": "#/$defs/Maintenance" },
        "minWebBuild": {
          "type": "integer",
          "minimum": 0,
          "description": "이보다 낮은 화면 버전은 강제 업데이트(BRD-43)."
        },
        "files": {
          "type": "object",
          "additionalProperties": false,
          "required": ["beaches", "status", "history", "nationwideWarnings"],
          "properties": {
            "beaches": { "$ref": "#/$defs/SnapshotPath" },
            "status": { "$ref": "#/$defs/SnapshotPath" },
            "history": { "$ref": "#/$defs/SnapshotPath" },
            "nationwideWarnings": { "$ref": "#/$defs/SnapshotPath" }
          }
        }
      }
    },

    "BeachesFile": {
      "title": "BeachesFile",
      "description": "/data/{v}/beaches.json. 저장소 data/beaches에서 만듦(17.5).",
      "type": "object",
      "additionalProperties": false,
      "required": ["beaches"],
      "properties": {
        "beaches": { "type": "array", "items": { "$ref": "#/$defs/Beach" } }
      }
    },

    "StatusFile": {
      "title": "StatusFile",
      "description": "/data/{v}/status.json. 키는 해변 내부 id.",
      "type": "object",
      "additionalProperties": false,
      "required": ["beaches"],
      "properties": {
        "beaches": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/BeachId" },
          "additionalProperties": { "$ref": "#/$defs/BeachStatus" }
        }
      }
    },

    "HistoryFile": {
      "title": "HistoryFile",
      "description": "/data/{v}/history.json. 관측소별 최근 24시간 파고, 1시간 간격(B2).",
      "type": "object",
      "additionalProperties": false,
      "required": ["stations"],
      "properties": {
        "stations": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/WaveHeightHistory" }
        }
      }
    },

    "NationwideWarningsFile": {
      "title": "NationwideWarningsFile",
      "description": "/data/{v}/nationwide-warnings.json. 홈의 '전국 해상 특보'.",
      "type": "object",
      "additionalProperties": false,
      "required": ["lastConfirmedAt", "items"],
      "properties": {
        "lastConfirmedAt": { "$ref": "#/$defs/NullableDateTime" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/WarningItem" } }
      }
    },

    "InquiryUploadRequest": {
      "title": "InquiryUploadRequest",
      "description": "문의 사진 업로드 양식 발급 요청.",
      "type": "object",
      "additionalProperties": false,
      "required": ["photos"],
      "properties": {
        "photos": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/InquiryUploadPhoto" }
        }
      }
    },

    "InquiryUploadPhoto": {
      "title": "InquiryUploadPhoto",
      "type": "object",
      "additionalProperties": false,
      "required": ["contentType", "size"],
      "properties": {
        "contentType": { "$ref": "#/$defs/InquiryPhotoContentType" },
        "size": { "type": "integer", "minimum": 1, "maximum": 5242880 }
      }
    },

    "InquiryUploadResponse": {
      "title": "InquiryUploadResponse",
      "type": "object",
      "additionalProperties": false,
      "required": ["uploads"],
      "properties": {
        "uploads": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/InquiryUploadTarget" }
        }
      }
    },

    "InquiryUploadTarget": {
      "title": "InquiryUploadTarget",
      "type": "object",
      "additionalProperties": false,
      "required": ["photoId", "key", "method", "url", "fields", "expiresAt"],
      "properties": {
        "photoId": { "$ref": "#/$defs/InquiryPhotoId" },
        "key": { "$ref": "#/$defs/InquiryPhotoKey" },
        "method": {
          "description": "multipart/form-data 양식 업로드(S3 presigned POST)만 씀.",
          "const": "POST"
        },
        "url": {
          "description": "서울 리전 S3 버킷의 가상 호스트 주소. 경로는 / 하나. 웹은 빌드 설정의 버킷 이름과 호스트가 정확히 같은지 다시 확인함.",
          "type": "string",
          "format": "uri",
          "pattern": "^https://[a-z0-9][a-z0-9-]{1,61}[a-z0-9]\\.s3\\.ap-northeast-2\\.amazonaws\\.com/$"
        },
        "fields": { "$ref": "#/$defs/InquiryUploadFields" },
        "expiresAt": { "$ref": "#/$defs/DateTime" }
      }
    },

    "InquiryUploadFields": {
      "title": "InquiryUploadFields",
      "description": "S3 presigned POST 양식 칸. 정해진 칸만 허용함.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "bucket",
        "Content-Type",
        "Policy",
        "X-Amz-Algorithm",
        "X-Amz-Credential",
        "X-Amz-Date",
        "X-Amz-Signature"
      ],
      "properties": {
        "key": { "$ref": "#/$defs/InquiryPhotoKey" },
        "bucket": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,61}[a-z0-9]$"
        },
        "Content-Type": { "$ref": "#/$defs/InquiryPhotoContentType" },
        "Policy": { "type": "string", "minLength": 1 },
        "X-Amz-Algorithm": { "const": "AWS4-HMAC-SHA256" },
        "X-Amz-Credential": { "type": "string", "minLength": 1 },
        "X-Amz-Date": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z$" },
        "X-Amz-Security-Token": { "type": "string", "minLength": 1 },
        "X-Amz-Signature": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },

    "CreateInquiryRequest": {
      "title": "CreateInquiryRequest",
      "type": "object",
      "additionalProperties": false,
      "required": ["idempotencyKey", "type", "message", "photos"],
      "properties": {
        "idempotencyKey": { "$ref": "#/$defs/InquiryIdempotencyKey" },
        "type": { "$ref": "#/$defs/InquiryType" },
        "message": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "beachId": { "$ref": "#/$defs/BeachId" },
        "activity": { "$ref": "#/$defs/Activity" },
        "photos": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/InquiryPhotoReference" }
        }
      },
      "dependentRequired": { "activity": ["beachId"] }
    },

    "InquiryPhotoReference": {
      "title": "InquiryPhotoReference",
      "type": "object",
      "additionalProperties": false,
      "required": ["photoId", "key"],
      "properties": {
        "photoId": { "$ref": "#/$defs/InquiryPhotoId" },
        "key": { "$ref": "#/$defs/InquiryPhotoKey" }
      }
    },

    "CreateInquiryResponse": {
      "title": "CreateInquiryResponse",
      "type": "object",
      "additionalProperties": false,
      "required": ["inquiryId", "receivedAt", "photos"],
      "properties": {
        "inquiryId": { "$ref": "#/$defs/InquiryId" },
        "receivedAt": { "$ref": "#/$defs/DateTime" },
        "photos": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/InquiryPhotoResult" }
        }
      }
    },

    "InquiryPhotoResult": {
      "title": "InquiryPhotoResult",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["photoId", "status"],
          "properties": {
            "photoId": { "$ref": "#/$defs/InquiryPhotoId" },
            "status": { "const": "accepted" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["photoId", "status", "reason"],
          "properties": {
            "photoId": { "$ref": "#/$defs/InquiryPhotoId" },
            "status": { "const": "rejected" },
            "reason": {
              "enum": ["location_metadata", "invalid_file", "not_found"]
            }
          }
        }
      ]
    },

    "InquiryErrorResponse": {
      "title": "InquiryErrorResponse",
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {
              "enum": [
                "invalid_request",
                "idempotency_conflict",
                "rate_limited",
                "service_unavailable"
              ]
            },
            "message": { "type": "string", "minLength": 1 }
          }
        }
      }
    },

    "InquiryType": {
      "title": "InquiryType",
      "description": "화면 유형 칩과 1:1(결정 기록 12장 결정 21). 정보가 실제와 달라요 · 판단 기준이 궁금해요 · 해변을 추가해 주세요 · 새 데이터를 제안해요.",
      "enum": [
        "data_error",
        "data_question",
        "beach_request",
        "data_suggestion"
      ]
    },
    "Activity": {
      "title": "Activity",
      "description": "출시 활동 3종(B7). 해변 activities와 문의 activity(장소 상세에서 들어온 문의의 해변 beachId와 함께만 보냄, 결정 기록 12장 결정 22)가 같이 씀.",
      "enum": ["swimming", "surfing", "scuba"]
    },
    "InquiryId": {
      "title": "InquiryId",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "InquiryIdempotencyKey": {
      "title": "InquiryIdempotencyKey",
      "description": "문의 한 건의 멱등 키(UUID v4). 같은 내용을 다시 보낼 때 같은 키를 씀. 서버는 같은 키의 두 번째 요청에 첫 결과를 그대로 돌려주고, 내용이 다르면 idempotency_conflict(409)로 거부함.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "InquiryPhotoContentType": {
      "title": "InquiryPhotoContentType",
      "enum": ["image/jpeg", "image/png", "image/webp"]
    },
    "InquiryPhotoId": {
      "title": "InquiryPhotoId",
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "InquiryPhotoKey": {
      "title": "InquiryPhotoKey",
      "type": "string",
      "pattern": "^pending/[0-9a-f]{32}/[0-9a-f]{16}$"
    },

    "Beach": {
      "title": "Beach",
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "id",
        "slug",
        "kind",
        "name",
        "region",
        "coast",
        "coords",
        "activities",
        "hidden",
        "warningZones",
        "stations",
        "photo",
        "cctv"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/BeachId" },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "주소용. 한 번 정하면 바꾸지 않음(BRD-45)."
        },
        "name": { "$ref": "#/$defs/LocalizedText" },
        "region": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sido", "sigungu"],
          "properties": {
            "sido": { "$ref": "#/$defs/LocalizedText" },
            "sigungu": { "$ref": "#/$defs/LocalizedText" }
          }
        },
        "coast": {
          "enum": ["east", "west", "south", "jeju"],
          "description": "해안 구분(동해안·서해안·남해안·제주). 지진해일 발표 지역 글과 장소를 잇는 데 씀(결정 기록 11장 10/20 ⑥·10/21 ④)."
        },
        "coords": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lat", "lng"],
          "properties": {
            "lat": { "type": "number", "minimum": 33, "maximum": 39 },
            "lng": { "type": "number", "minimum": 124, "maximum": 132 }
          }
        },
        "activities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/Activity" },
          "description": "스노클링은 출시 제외(B7)."
        },
        "hidden": {
          "type": "boolean",
          "description": "노출 끔. true면 목록에서 숨기고 상세는 404(BRD-45)."
        },
        "stations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "waveHeight",
            "wavePeriod",
            "waveDirection",
            "waterTemp",
            "wind"
          ],
          "properties": {
            "waveHeight": { "$ref": "#/$defs/StationRef" },
            "wavePeriod": { "$ref": "#/$defs/StationRef" },
            "waveDirection": { "$ref": "#/$defs/StationRef" },
            "waterTemp": { "$ref": "#/$defs/StationRef" },
            "wind": { "$ref": "#/$defs/StationRef" }
          }
        },
        "photo": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["url", "source", "license"],
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://"
                },
                "source": { "type": "string", "minLength": 1 },
                "license": {
                  "enum": ["kogl-type1"],
                  "description": "공공누리 유형 코드값(D9). 1유형(출처표시)만 사용(결정 기록 11장 10/21). 화면 표기는 문구 키로."
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "description": "저작물명(출처 표시용)."
                },
                "pageUrl": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://",
                  "description": "원본 페이지(출처 표시용)."
                }
              }
            }
          ]
        },
        "cctv": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["url", "source"],
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://",
                  "description": "https 직접 표시만(D7)."
                },
                "source": { "type": "string", "minLength": 1 }
              }
            }
          ]
        }
      },
      "oneOf": [
        {
          "title": "BeachSite",
          "type": "object",
          "required": ["kind", "warningZones"],
          "properties": {
            "kind": {
              "enum": ["beach", "undesignated_beach"],
              "description": "해변. beach = 해수부 지정 해수욕장, undesignated_beach = 지정 해수욕장이 아닌 해변(결정 기록 11장 10/21, BRD-73)."
            },
            "warningZones": { "$ref": "#/$defs/WarningZones" }
          }
        },
        {
          "title": "DivePoint",
          "type": "object",
          "required": ["kind", "warningZones"],
          "properties": {
            "kind": {
              "const": "dive_point",
              "description": "스쿠버 포인트(바다 위). 육상 구역 생략 가능(결정 기록 11장 10/21, BRD-73)."
            },
            "warningZones": { "$ref": "#/$defs/SeaWarningZones" }
          }
        }
      ]
    },

    "WarningZones": {
      "title": "WarningZones",
      "description": "해변의 특보구역. 앞바다(풍랑)·시군 육상(강풍) 모두 필수.",
      "type": "object",
      "additionalProperties": false,
      "required": ["sea", "land"],
      "properties": {
        "sea": {
          "type": "string",
          "pattern": "^S1[0-9]{6}$",
          "description": "앞바다 특보구역(풍랑)."
        },
        "land": {
          "type": "string",
          "pattern": "^L1[0-9]{6}$",
          "description": "시군 육상 특보구역(강풍)."
        }
      }
    },

    "SeaWarningZones": {
      "title": "SeaWarningZones",
      "description": "스쿠버 포인트의 특보구역. 바다 위라 육상 구역은 생략 가능.",
      "type": "object",
      "additionalProperties": false,
      "required": ["sea"],
      "properties": {
        "sea": {
          "type": "string",
          "pattern": "^S1[0-9]{6}$",
          "description": "앞바다 특보구역(풍랑)."
        },
        "land": {
          "type": "string",
          "pattern": "^L1[0-9]{6}$",
          "description": "시군 육상 특보구역(강풍). 생략 가능."
        }
      }
    },

    "BeachStatus": {
      "title": "BeachStatus",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "reasons",
        "warning",
        "control",
        "observation",
        "info",
        "validUntil"
      ],
      "properties": {
        "category": { "enum": ["clear", "unavailable", "undetermined"] },
        "reasons": { "type": "array", "items": { "$ref": "#/$defs/Reason" } },
        "warning": { "$ref": "#/$defs/WarningState" },
        "control": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": {
            "state": {
              "const": "not_provided",
              "description": "출시는 통제를 판단하지 않음(G2)."
            }
          }
        },
        "observation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["metrics"],
          "properties": {
            "metrics": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "waveHeight",
                "wavePeriod",
                "waveDirection",
                "waterTemp",
                "wind"
              ],
              "properties": {
                "waveHeight": { "$ref": "#/$defs/Metric" },
                "wavePeriod": { "$ref": "#/$defs/Metric" },
                "waveDirection": { "$ref": "#/$defs/Metric" },
                "waterTemp": { "$ref": "#/$defs/Metric" },
                "wind": { "$ref": "#/$defs/Metric" }
              }
            }
          }
        },
        "info": {
          "type": "object",
          "additionalProperties": false,
          "required": ["season", "ripCurrent", "nearbyWarnings"],
          "properties": {
            "season": {
              "description": "운영 기간 정보. 대응표가 없으면 null(배지 숨김, N4).",
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["openFrom", "openUntil", "inSeason"],
                  "properties": {
                    "openFrom": { "type": "string", "format": "date" },
                    "openUntil": { "type": "string", "format": "date" },
                    "inSeason": { "type": "boolean" }
                  }
                }
              ]
            },
            "ripCurrent": {
              "description": "이안류 지수. 정보 표시만(D5). 제공 해변·기간이 아니면 null. 단계 값 형식은 API 확인 후 확정.",
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["label", "publishedAt", "source"],
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "description": "기관 발표 단계 원문."
                    },
                    "publishedAt": { "$ref": "#/$defs/DateTime" },
                    "source": { "type": "string", "minLength": 1 }
                  }
                }
              ]
            },
            "nearbyWarnings": {
              "description": "주변 특보. 판단에 쓰지 않는 특보(호우·폭염 등)를 정보로만 표시(B3, 10/17 결정). 없으면 빈 목록.",
              "type": "array",
              "items": { "$ref": "#/$defs/NearbyWarningItem" }
            }
          }
        },
        "validUntil": {
          "$ref": "#/$defs/DateTime",
          "description": "min(파고 observedAt + 90분, 특보 lastConfirmedAt + 45분) (B4). 파고가 이미 지연(delayed)이면 특보 lastConfirmedAt + 45분만 사용(10/17 결정)."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "category": { "const": "clear" } } },
          "then": {
            "properties": {
              "reasons": { "maxItems": 0 },
              "warning": { "properties": { "state": { "const": "none" } } }
            }
          }
        },
        {
          "if": { "properties": { "category": { "const": "unavailable" } } },
          "then": {
            "properties": {
              "reasons": {
                "minItems": 1,
                "contains": { "properties": { "code": { "const": "warning" } } }
              },
              "warning": { "properties": { "state": { "const": "active" } } }
            }
          }
        },
        {
          "if": { "properties": { "category": { "const": "undetermined" } } },
          "then": {
            "properties": {
              "reasons": {
                "minItems": 1,
                "items": {
                  "properties": {
                    "code": {
                      "enum": ["warning_unknown", "observation_delayed"]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },

    "Reason": {
      "title": "Reason",
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "scope", "source", "at"],
      "properties": {
        "code": {
          "enum": ["warning", "warning_unknown", "observation_delayed"],
          "description": "통제 code(control_*)는 후속용으로 이름만 예약(아키텍처 6.3)."
        },
        "type": { "$ref": "#/$defs/WarningType" },
        "level": { "$ref": "#/$defs/WarningLevel" },
        "scope": {
          "type": "string",
          "minLength": 1,
          "description": "범위. 예: 특보구역 이름, 관측소 이름."
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "기관. 예: 기상청."
        },
        "at": {
          "$ref": "#/$defs/NullableDateTime",
          "description": "발표 또는 관측 시각."
        }
      },
      "if": { "properties": { "code": { "const": "warning" } } },
      "then": { "required": ["type", "level"] },
      "else": {
        "not": {
          "anyOf": [{ "required": ["type"] }, { "required": ["level"] }]
        }
      }
    },

    "WarningState": {
      "title": "WarningState",
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "items", "source", "lastConfirmedAt"],
      "properties": {
        "state": { "enum": ["none", "active", "unknown"] },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/WarningItem" }
        },
        "source": { "type": "string", "minLength": 1 },
        "lastConfirmedAt": { "$ref": "#/$defs/NullableDateTime" }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "none" } } },
          "then": {
            "properties": {
              "items": { "maxItems": 0 },
              "lastConfirmedAt": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "active" } } },
          "then": {
            "properties": {
              "items": { "minItems": 1 },
              "lastConfirmedAt": { "type": "string" }
            }
          }
        }
      ]
    },

    "WarningItem": {
      "title": "WarningItem",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "level",
        "zoneCode",
        "zoneName",
        "publishedAt",
        "effectiveFrom"
      ],
      "properties": {
        "type": { "$ref": "#/$defs/WarningType" },
        "level": { "$ref": "#/$defs/WarningLevel" },
        "zoneCode": {
          "type": ["string", "null"],
          "pattern": "^[SL][0-9]{7}$",
          "description": "특보구역 코드. 지진해일만 null(구역 코드 없음, 10/22)."
        },
        "zoneName": {
          "type": "string",
          "minLength": 1,
          "description": "공식 구역 이름. 지진해일은 getTsunamiMsg reg 원문."
        },
        "publishedAt": { "$ref": "#/$defs/DateTime" },
        "effectiveFrom": { "$ref": "#/$defs/DateTime" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "not": { "const": "tsunami" } } } },
          "then": { "properties": { "zoneCode": { "type": "string" } } }
        }
      ]
    },

    "WarningType": {
      "title": "WarningType",
      "description": "판단하는 바다 관련 특보 5종(B3): 풍랑·강풍·태풍·폭풍해일·지진해일.",
      "enum": ["wind_wave", "strong_wind", "typhoon", "storm_surge", "tsunami"]
    },

    "WarningLevel": {
      "title": "WarningLevel",
      "description": "주의보 / 경보 / 중대경보(getPwnCd warnStress 0·1·2, 10/20).",
      "enum": ["advisory", "warning", "severe_warning"]
    },

    "NearbyWarningItem": {
      "title": "NearbyWarningItem",
      "description": "주변 특보 항목. 분류에 영향 없음.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "level",
        "zoneCode",
        "zoneName",
        "publishedAt",
        "effectiveFrom"
      ],
      "properties": {
        "type": { "$ref": "#/$defs/NearbyWarningType" },
        "level": { "$ref": "#/$defs/WarningLevel" },
        "zoneCode": { "type": "string", "pattern": "^[SL][0-9]{7}$" },
        "zoneName": { "type": "string", "minLength": 1 },
        "publishedAt": { "$ref": "#/$defs/DateTime" },
        "effectiveFrom": { "$ref": "#/$defs/DateTime" }
      }
    },

    "NearbyWarningType": {
      "title": "NearbyWarningType",
      "description": "판단에 쓰지 않는 특보(B3): 호우·폭염·한파·대설·건조·황사·열대야(10/20).",
      "enum": [
        "heavy_rain",
        "heat_wave",
        "cold_wave",
        "heavy_snow",
        "dry",
        "yellow_dust",
        "tropical_night"
      ]
    },

    "Metric": {
      "title": "Metric",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit",
        "observedAt",
        "state",
        "nextExpectedAt",
        "expiresAt"
      ],
      "properties": {
        "value": { "type": ["number", "null"] },
        "unit": { "enum": ["m", "s", "deg", "°C", "m/s"] },
        "observedAt": { "$ref": "#/$defs/NullableDateTime" },
        "state": {
          "enum": ["fresh", "delayed", "none"],
          "description": "none = 20km 안 측정기 없음(분류 영향 없음)."
        },
        "nextExpectedAt": { "$ref": "#/$defs/NullableDateTime" },
        "expiresAt": {
          "$ref": "#/$defs/NullableDateTime",
          "description": "파고·수온·바람 observedAt + 90분, 파주기·파향 + 60분(B4, 파향은 파주기와 같은 kma_buoy, 10/21)."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "fresh" } } },
          "then": {
            "properties": {
              "value": { "type": "number" },
              "observedAt": { "type": "string" },
              "expiresAt": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "none" } } },
          "then": {
            "properties": {
              "value": { "type": "null" },
              "observedAt": { "type": "null" },
              "expiresAt": { "type": "null" }
            }
          }
        }
      ]
    },

    "WaveHeightHistory": {
      "title": "WaveHeightHistory",
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "points"],
      "properties": {
        "unit": { "const": "m" },
        "points": {
          "type": "array",
          "maxItems": 25,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["t", "v"],
            "properties": {
              "t": { "$ref": "#/$defs/DateTime" },
              "v": {
                "type": ["number", "null"],
                "minimum": 0,
                "description": "null = 측정값 없음(차트 빗금)."
              }
            }
          }
        }
      }
    },

    "StationRef": {
      "title": "StationRef",
      "description": "대표 관측소. 같은 해상 특보구역 20km 안에 없으면 null → '가까운 관측 없음'.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name", "distanceKm"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "name": { "$ref": "#/$defs/LocalizedText" },
            "distanceKm": { "type": "number", "minimum": 0, "maximum": 20 }
          }
        }
      ]
    },

    "Maintenance": {
      "title": "Maintenance",
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "until"],
      "properties": {
        "active": { "type": "boolean" },
        "until": {
          "$ref": "#/$defs/NullableDateTime",
          "description": "점검 종료 예정. 모르면 null."
        }
      }
    },

    "LocalizedText": {
      "title": "LocalizedText",
      "type": "object",
      "additionalProperties": false,
      "required": ["ko", "en"],
      "properties": {
        "ko": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    },

    "BeachId": {
      "title": "BeachId",
      "type": "string",
      "pattern": "^b[0-9]{4}$",
      "description": "내부 id. 예: b0001"
    },
    "SnapshotPath": {
      "title": "SnapshotPath",
      "type": "string",
      "pattern": "^/data/[0-9]{8}T[0-9]{6}Z/[a-z-]+\\.json$"
    },
    "DateTime": {
      "title": "DateTime",
      "type": "string",
      "format": "date-time",
      "description": "UTC, 예: 2026-10-17T05:30:00Z"
    },
    "NullableDateTime": {
      "title": "NullableDateTime",
      "type": ["string", "null"],
      "format": "date-time"
    }
  }
}
