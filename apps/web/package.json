{
  "name": "@baradun/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run tokens && npm run map:worker",
    "dev": "node scripts/dev.mts",
    "dev:no-data": "npm run dev:data -- --clean && npm run dev -- --data=off",
    "live": "npm run dev -- --data=live",
    "prebuild": "npm run tokens && npm run map:worker && node scripts/dev-data.mts --check",
    "dev:data": "node scripts/dev-data.mts",
    "build": "next build",
    "postbuild": "node scripts/build-sw.mts && node scripts/csp-meta.mts",
    "check:csp": "node scripts/csp-meta.mts --check",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prestorybook": "npm run tokens && npm run map:worker",
    "storybook": "storybook dev -p 6006",
    "prebuild-storybook": "npm run tokens && npm run map:worker",
    "build-storybook": "storybook build",
    "test:e2e": "playwright test",
    "tokens": "baradun-tokens src/styles/tokens.css",
    "icons": "node scripts/build-icons.mts",
    "map:worker": "node scripts/copy-map-worker.mjs",
    "og:image": "node scripts/build-og-image.mjs",
    "check:tokens": "baradun-tokens-check",
    "check:messages": "node scripts/check-messages.mjs",
    "check:map": "node scripts/map-smoke.mts"
  },
  "dependencies": {
    "@baradun/contracts": "0.1.0",
    "@fontsource-variable/noto-sans-kr": "^5.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.57.0",
    "maplibre-gl": "6.16.0",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@baradun/design-tokens": "0.1.0",
    "@playwright/test": "^1.64.0",
    "@storybook/addon-a11y": "^10.2.9",
    "@storybook/addon-docs": "^10.2.9",
    "@storybook/nextjs-vite": "^10.2.9",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "storybook": "^10.2.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
