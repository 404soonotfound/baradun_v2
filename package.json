{
  "name": "baradun-v2",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services",
    "infra"
  ],
  "scripts": {
    "dev": "npm run dev -w @baradun/web",
    "live": "npm run live -w @baradun/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:beaches && npm run test:agy-review && npm run test:map-tiles && npm run test --workspaces --if-present",
    "test:beaches": "vitest run --root tools/beaches",
    "test:agy-review": "vitest run --root tools/agy-review",
    "test:map-tiles": "vitest run --root tools/map-tiles",
    "build": "npm run build --workspaces --if-present",
    "deploy:prod": "node scripts/deploy-prod.mjs",
    "deploy:infra": "npm run deploy -w infra --",
    "keys:expires": "npm run keys:expires -w infra --"
  }
}
